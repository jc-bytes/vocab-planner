{"kind":"table","sheet":"Template","address":"A1:E37","rows":37,"cols":5,"values":[["It is recommended that you do not edit rubrics in spreadsheet format",null,null,null,null],["v1.0-s",null,null,null,null],["Name, class, and date",null,null,null,null],["Enter your complete name, class, and date on the final poster.",null,null,null,null],[null,1,0,null,null],[null,"Complete","Incomplete",null,null],[null,"1 pt = complete name, class, and date.","0 pts = name, class, or date is missing or incomplete.",null,null],["Poster structure and driver/navigator roles",null,null,null,null],["4 checks: (1) creates a one-page digital poster with a clear title; (2) explains the driver role; (3) explains the navigator role; and (4) describes how the roles were used, shared, or changed during the pair-programming activity.",null,null,null,null],[null,7,5,3,0],[null,"Meets Standard","Approaches Standard","Below Standard","Unacceptable"],[null,"7 pts = 4 checks.","5 pts = 2–3.","3 pts = 1.","0 pts = 0 or no poster."],["Effort and participation",null,null,null,null],["3 checks: the reflection (1) gives one specific example of participation or contribution; (2) identifies one thing done well; and (3) identifies one realistic area for improvement.",null,null,null,null],[null,7,5,3,0],[null,"Meets Standard","Approaches Standard","Below Standard","Unacceptable"],[null,"7 pts = 3 checks.","5 pts = 2.","3 pts = 1.","0 pts = 0 or no reflection."],["Communication and teamwork",null,null,null,null],["4 checks: the reflection (1) explains how they communicated; (2) gives one example of listening, explaining, asking, or answering; (3) describes how both partners worked together; and (4) identifies one way communication could be maintained or improved.",null,null,null,null],[null,7,5,3,0],[null,"Meets Standard","Approaches Standard","Below Standard","Unacceptable"],[null,"7 pts = 4 checks.","5 pts = 2–3.","3 pts = 1.","0 pts = 0 or no reflection."],["Organization and problem solving",null,null,null,null],["4 checks: the reflection (1) explains how they organized the task or divided the work; (2) gives one example of staying focused or prepared; (3) describes how the pair handled a problem or difficulty; and (4) identifies one organizational strategy that helped or could help next time.",null,null,null,null],[null,7,5,3,0],[null,"Meets Standard","Approaches Standard","Below Standard","Unacceptable"],[null,"7 pts = 4 checks.","5 pts = 2–3.","3 pts = 1.","0 pts = 0 or no reflection."],["Responding to feedback",null,null,null,null],["4 checks: the reflection (1) identifies feedback received from a partner, peer, or teacher; (2) explains how the student responded to the feedback; (3) describes one change, correction, or improvement made because of it; and (4) states how feedback can help future work.",null,null,null,null],[null,7,5,3,0],[null,"Meets Standard","Approaches Standard","Below Standard","Unacceptable"],[null,"7 pts = 4 checks.","5 pts = 2–3.","3 pts = 1.","0 pts = 0 or no reflection."],["Punctuality, readiness, and respect",null,null,null,null],["4 checks: (1) Submits all required work by the deadline; (2) arrives with a charged computer, charger, login access, pen, and notebook; (3) handles the computer, charger, cables, and workspace carefully; and (4) begins on time, follows directions, works respectfully with the partner, and does not interfere with another student’s device or work.",null,null,null,null],[null,4,3,1,0],[null,"Meets Standard","Approaches Standard","Below Standard","Unacceptable"],[null,"4 pts = 4 steps.","3 pts = 2–3.","1 pt = 1.","0 pts = none."]]}
