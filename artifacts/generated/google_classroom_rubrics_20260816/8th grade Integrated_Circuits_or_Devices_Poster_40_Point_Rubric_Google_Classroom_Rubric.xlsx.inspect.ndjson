{"kind":"table","sheet":"Template","address":"A1:E37","rows":37,"cols":5,"values":[["It is recommended that you do not edit rubrics in spreadsheet format",null,null,null,null],["v1.0-s",null,null,null,null],["Name, class, and date",null,null,null,null],["Enter your complete name, class, and date in the final poster.",null,null,null,null],[null,1,0,null,null],[null,"Complete","Incomplete",null,null],[null,"1 pt = complete name, class, and date.","0 pts = name, class, or date is missing or incomplete.",null,null],["Poster structure, title, and template",null,null,null,null],["4 checks: (1) uses the teacher-provided Canva poster template; (2) creates one complete poster; (3) includes a clear title about the selected integrated circuit or device; and (4) the required sections are easy to identify.",null,null,null,null],[null,7,5,3,0],[null,"Meets Standard","Approaches Standard","Below Standard","Unacceptable"],[null,"7 pts = 4 checks.","5 pts = 2–3.","3 pts = 1.","0 pts = 0 or no poster."],["What they are",null,null,null,null],["4 checks: (1) clearly identifies the selected integrated circuit or device; (2) explains what it is; (3) includes at least three accurate facts or characteristics; and (4) explains what it does or how it is used.",null,null,null,null],[null,7,5,3,0],[null,"Meets Standard","Approaches Standard","Below Standard","Unacceptable"],[null,"7 pts = 4 checks.","5 pts = 2–3.","3 pts = 1.","0 pts = 0 or no explanation."],["Advantages",null,null,null,null],["4 checks: (1) includes at least two relevant advantages; (2) clearly explains the first advantage; (3) clearly explains the second advantage; and (4) both advantages relate directly to the selected circuit or device.",null,null,null,null],[null,7,5,3,0],[null,"Meets Standard","Approaches Standard","Below Standard","Unacceptable"],[null,"7 pts = 4 checks.","5 pts = 2–3.","3 pts = 1.","0 pts = 0 or no advantages."],["Use of provided sources and accuracy",null,null,null,null],["4 checks: (1) uses the teacher-provided sources; (2) the description matches the sources; (3) the advantages are supported by the sources; and (4) the poster contains no incorrect or unsupported claims.",null,null,null,null],[null,7,5,3,0],[null,"Meets Standard","Approaches Standard","Below Standard","Unacceptable"],[null,"7 pts = 4 checks.","5 pts = 2–3.","3 pts = 1.","0 pts = 0 or information is not source-based."],["Images, readability, and English",null,null,null,null],["4 checks: (1) includes at least one relevant image or icon; (2) visuals support the topic; (3) text is readable, organized, and fits the template; and (4) the title, labels, and explanations are written in clear English.",null,null,null,null],[null,7,5,3,0],[null,"Meets Standard","Approaches Standard","Below Standard","Unacceptable"],[null,"7 pts = 4 checks.","5 pts = 2–3.","3 pts = 1.","0 pts = 0 or poster is not readable."],["Punctuality, readiness, and respect",null,null,null,null],["4 checks: (1) Submits all required work by the deadline; (2) arrives with a charged computer, charger, login access, pen, and notebook; (3) handles the computer, charger, and workspace carefully; and (4) begins on time, follows directions, and does not interfere with another student’s device or work.",null,null,null,null],[null,4,3,1,0],[null,"Meets Standard","Approaches Standard","Below Standard","Unacceptable"],[null,"4 pts = 4 steps.","3 pts = 2–3.","1 pt = 1.","0 pts = none."]]}
