{"kind":"table","sheet":"Template","address":"A1:E37","rows":37,"cols":5,"values":[["It is recommended that you do not edit rubrics in spreadsheet format",null,null,null,null],["v1.0-s",null,null,null,null],["Name, class, and date",null,null,null,null],["Enter your complete name, class, and date on the submitted project or required evidence.",null,null,null,null],[null,1,0,null,null],[null,"Complete","Incomplete",null,null],[null,"1 pt = complete name, class, and date.","0 pts = name, class, or date is missing or incomplete.",null,null],["Finished working game and submission",null,null,null,null],["4 checks: (1) the rhythm game is finished; (2) the project opens and starts correctly; (3) the game can be played from beginning to end without a game-breaking error; and (4) the finished project is submitted in the correct place and format.",null,null,null,null],[null,7,5,3,0],[null,"Meets Standard","Approaches Standard","Below Standard","Unacceptable"],[null,"7 pts = 4 checks.","5 pts = 2–3.","3 pts = 1.","0 pts = 0 or no submitted game."],["Required sprites and variables",null,null,null,null],["4 checks: the project (1) includes the required sprites or game objects; (2) includes the required variables; (3) initializes important variables correctly when the game starts; and (4) uses the sprites and variables correctly during gameplay.",null,null,null,null],[null,7,5,3,0],[null,"Meets Standard","Approaches Standard","Below Standard","Unacceptable"],[null,"7 pts = 4 checks.","5 pts = 2–3.","3 pts = 1.","0 pts = 0 or required components are missing."],["Connected scripts and game logic",null,null,null,null],["4 checks: (1) required scripts begin with an appropriate event or condition; (2) blocks are connected in the correct order; (3) scripts produce the intended game actions or outputs; and (4) the main game logic works together without broken or conflicting required scripts.",null,null,null,null],[null,7,5,3,0],[null,"Meets Standard","Approaches Standard","Below Standard","Unacceptable"],[null,"7 pts = 4 checks.","5 pts = 2–3.","3 pts = 1.","0 pts = 0 or core logic does not work."],["Player input and scoring",null,null,null,null],["4 checks: the game (1) detects the required player inputs; (2) responds correctly when the player acts at the correct time; (3) changes the score correctly for successful actions; and (4) does not incorrectly award points for missed or invalid actions.",null,null,null,null],[null,7,5,3,0],[null,"Meets Standard","Approaches Standard","Below Standard","Unacceptable"],[null,"7 pts = 4 checks.","5 pts = 2–3.","3 pts = 1.","0 pts = 0 or input/scoring does not work."],["Scratch platform understanding and usage",null,null,null,null],["4 checks: (1) uses Scratch correctly to create and run the game; (2) uses appropriate sprites, scripts, and variables for the required gameplay; (3) connects blocks correctly so the scripts work as intended; and (4) demonstrates understanding of the platform by organizing and testing the project without broken or unnecessary code.",null,null,null,null],[null,7,5,3,0],[null,"Meets Standard","Approaches Standard","Below Standard","Unacceptable"],[null,"7 pts = 4 checks.","5 pts = 2–3.","3 pts = 1.","0 pts = 0 or gameplay is not functional."],["Punctuality, readiness, and respect",null,null,null,null],["4 checks: (1) Submits the finished game by the deadline; (2) arrives with a charged computer, charger, login access, pen, and notebook; (3) handles the computer, charger, cables, and workspace carefully; and (4) begins on time, follows directions, and does not interfere with another student’s device or work.",null,null,null,null],[null,4,3,1,0],[null,"Meets Standard","Approaches Standard","Below Standard","Unacceptable"],[null,"4 pts = 4 steps.","3 pts = 2–3.","1 pt = 1.","0 pts = none."]]}
